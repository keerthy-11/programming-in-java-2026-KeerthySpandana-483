import java.io.File;
import java.io.FileWriter;
import java.io.FileReader;
import java.io.BufferedReader;
import java.io.IOException;
import java.util.Scanner;
class LibraryTransaction {
    String bookId;
    String bookName;
    String studentName;
    String issueDate;
    String returnDate;
    LibraryTransaction(String bookId, String bookName,
                       String studentName, String issueDate,
                       String returnDate) {
        this.bookId = bookId;
        this.bookName = bookName;
        this.studentName = studentName;
        this.issueDate = issueDate;
        this.returnDate = returnDate;
    }
    public String toString() {
        return "Book ID: " + bookId
                + "\nBook Name: " + bookName
                + "\nStudent Name: " + studentName
                + "\nIssue Date: " + issueDate
                + "\nReturn Date: " + returnDate
                + "\n--------------------------";
    }
}
public class Main {
    static final String FILE_NAME = "library_transactions.txt";
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int choice;
        do {
            System.out.println("\n--- Library Management System ---");
            System.out.println("1. Record Book Transaction");
            System.out.println("2. View Transaction Records");
            System.out.println("3. Exit");
            System.out.print("Enter your choice: ");
            choice = sc.nextInt();
            sc.nextLine();
            switch (choice) {
                case 1:
                    System.out.print("Enter Book ID: ");
                    String id = sc.nextLine();
                    System.out.print("Enter Book Name: ");
                    String name = sc.nextLine();
                    System.out.print("Enter Student/User Name: ");
                    String student = sc.nextLine();
                    System.out.print("Enter Issue Date: ");
                    String issue = sc.nextLine();
                    System.out.print("Enter Return Date: ");
                    String ret = sc.nextLine();
                    if (id.isEmpty() || name.isEmpty()
                            || student.isEmpty()
                            || issue.isEmpty() || ret.isEmpty()) {
                        System.out.println(
                                "Please enter all transaction details.");
                        break;
                    }
                    LibraryTransaction transaction =
                            new LibraryTransaction(
                                    id, name, student, issue, ret);
                    try (FileWriter fw =
                                 new FileWriter(FILE_NAME, true)) {
                        fw.write(transaction.toString()
                                + System.lineSeparator());
                        System.out.println(
                                "Transaction recorded successfully.");
                    } catch (IOException e) {
                        System.out.println(
                                "Error writing to file: " + e.getMessage());
                    }
                    break;
                case 2:
                    File file = new File(FILE_NAME);
                    if (!file.exists() || file.length() == 0) {
                        System.out.println(
                                "No transaction records found.");
                        break;
                    }
                    try (FileReader fr = new FileReader(file);
                         BufferedReader br = new BufferedReader(fr)) {
                        String line;
                        while ((line = br.readLine()) != null) {
                            System.out.println(line);
                        }
                    } catch (IOException e) {
                        System.out.println(
                                "Error reading file: " + e.getMessage());
                    }
                    break;
                case 3:
                    System.out.println(
                            "Exiting Library Management System.");
                    break;
                default:
                    System.out.println(
                            "Invalid choice. Please select a valid option.");
            }
        } while (choice != 3);
        sc.close();
    }
}
